# =============================================
# MapHome Mobile App - Environment Variables
# =============================================
# Copy file này thành .env và điền các giá trị thực.
# Tất cả biến phải có prefix EXPO_PUBLIC_ để Expo nhận diện.

# ---------------------------
# Backend API
# ---------------------------
# URL gốc của backend API (không có dấu / ở cuối)
EXPO_PUBLIC_API_URL=https://exe101project-maphome-api.up.railway.app

# Toggle run local backend (true) or deploy link (false)
EXPO_PUBLIC_USE_LOCAL_BACKEND=true
# (Optional) Địa chỉ IP của máy tính host nếu chạy thử trên thiết bị di động thật (Expo Go)
# EXPO_PUBLIC_LOCAL_API_URL=http://192.168.1.100:5000

# ---------------------------
# Google OAuth
# ---------------------------
# Google OAuth 2.0 Client ID (lấy từ Google Cloud Console)
# Project: MapHome | Type: Web application
EXPO_PUBLIC_GOOGLE_CLIENT_ID=817734182215-ijh0r2a1fbcsm5u5nams9e92obh5cmck.apps.googleusercontent.com
# iOS OAuth Client ID — tạo trong Google Console với Bundle ID: host.exp.exponent (Expo Go)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=817734182215-0bmgjcggm7k7h0qice3lff1dr7s3q638.apps.googleusercontent.com

# ---------------------------
# Goong Maps (bản đồ)
# ---------------------------
# API Key của Goong Maps (lấy từ https://account.goong.io)
EXPO_PUBLIC_GOONG_MAPTILES_KEY=zkJufOSOzrjhp0HuujejyHhJ2S3G2O6SkK56wiSF
